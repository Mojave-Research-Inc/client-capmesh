# Capability Mesh Environment Configuration
# Copy to .env and populate with values from the environment (secrets in OpenBao)

# Microsoft Entra ID Configuration
# Canonical MULTI-TENANT authority (any M365 org can sign in).
CAPMESH_ENTRA_AUTHORITY=https://login.microsoftonline.com/organizations/oauth2/v2.0
# Entra app client id. M365 uses auth-code + PKCE via a public client; there is
# no client secret. Source reads ONLY CAPMESH_M365_CLIENT_ID (never ENTRA_*_ID/SECRET).
CAPMESH_M365_CLIENT_ID=
# DEPLOYING org tenant id — required for SCIM provisioning. Set before the
# authoritative-node installer (hard-required by install-capability-mesh-tailnet-service.sh).
CAPMESH_ENTRA_TENANT_ID=<your-m365-tenant-id>

# Google OAuth 2.0 Configuration (for Google Sign-in)
# Client ID from Google Cloud Console (your-gcp-project)
CAPMESH_GOOGLE_CLIENT_ID=
# Client Secret from Google Cloud Console (stored in your secret manager web_client_secret)
CAPMESH_GOOGLE_CLIENT_SECRET=
# Redirect URI for Google OAuth callback (must match Google Cloud Console configuration exactly)
CAPMESH_GOOGLE_REDIRECT_URI=https://capmesh.<your-tailnet>.ts.net/api/v1/auth/google/callback
# Comma-separated list of Gmail addresses allowed to sign in (OAuth consent screen Test Users)
CAPMESH_GOOGLE_ALLOWED_EMAILS=guest1@gmail.com

# Server Configuration
CAPMESH_HOST=0.0.0.0
CAPMESH_PORT=8000
CAPMESH_INTERFACE=tailscale0

# Database
CAPMESH_DB_PATH=~/.capmesh/capability-mesh.db

# Optional: Enable verbose logging
DEBUG=false

# --- Hard-required placeholders (set before install-capability-mesh-tailnet-service.sh) ---
# These are ${VAR:?} fail-closed required by the authoritative-node installer.
# Run from the repo root; populate with neutral values for your tailnet/org.
#   CAPMESH_SERVE_NAME        this node's Tailscale MagicDNS name (real *.ts.net)
#   CAPMESH_ENTRA_TENANT_ID   (above) your Microsoft 365 / Entra tenant id (for OIDC + SCIM)
#   CAPMESH_GIT_DIR           path to the registry mirror git dir (used by ops/git-sync.sh refresh loop)
CAPMESH_SERVE_NAME=capmesh.<your-tailnet>.ts.net
CAPMESH_GIT_DIR=<registry-mirror-path>
