{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asg.local/schemas/cap.schema.json",
  "title": "ASG Capability Package Manifest",
  "type": "object",
  "required": ["name", "type", "version", "description"],
  "properties": {
    "uri": {"type": "string", "pattern": "^cap://"},
    "name": {"type": "string", "minLength": 1, "maxLength": 128},
    "type": {
      "type": "string",
      "enum": ["skill", "agent", "plugin", "command", "mcp_server", "workflow", "reference", "bundle"]
    },
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([-.+][A-Za-z0-9.-]+)?$"},
    "title": {"type": "string"},
    "description": {"type": "string", "minLength": 1},
    "entrypoint": {"type": "string"},
    "visibility": {"type": "string", "enum": ["public", "internal", "protected", "secret"], "default": "internal"},
    "discoveryMode": {"type": "string", "enum": ["public", "locked", "hidden"], "default": "public"},
    "owner": {"type": "string"},
    "plugin": {"type": "string"},
    "category": {"type": "string"},
    "keywords": {"type": "array", "items": {"type": "string"}},
    "requiredScopes": {"type": "array", "items": {"type": "string"}},
    "allowGroups": {"type": "array", "items": {"type": "string"}},
    "allowUsers": {"type": "array", "items": {"type": "string"}},
    "riskTier": {"type": "string", "enum": ["low", "medium", "high", "critical"], "default": "low"},
    "mutating": {"type": "boolean", "default": false},
    "callable": {"type": "object"},
    "provenance": {"type": "object"}
  },
  "additionalProperties": true
}

