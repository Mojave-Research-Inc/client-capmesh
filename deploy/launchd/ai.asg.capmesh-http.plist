<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>ai.asg.capmesh-http</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/bash</string>
    <string>CAPMESH_STATE_DIR/current/ops/serve-nonvoting-macos.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>CAPMESH_ENV_FILE</key><string>~/.capmesh/capmesh-fallback.env</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key>
  <dict><key>SuccessfulExit</key><false/></dict>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>~/.capmesh/http.log</string>
  <key>StandardErrorPath</key><string>~/.capmesh/http.err</string>
</dict>
</plist>
